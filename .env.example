# Copy to .env and fill in. Never commit .env.

# --- OpenAI (required) ---
OPENAI_API_KEY=
# Strong model for the research agent, cheap model for the triage router.
OPENAI_MODEL_RESEARCH=gpt-5
OPENAI_MODEL_TRIAGE=gpt-5-mini
# Reasoning effort: minimal | low | medium | high (higher = slower, more thorough)
OPENAI_REASONING_RESEARCH=low
OPENAI_REASONING_TRIAGE=low

# --- Slack (required for `python -m trends_agent slack`) ---
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-
# Only needed when SLACK_MODE=http
SLACK_SIGNING_SECRET=
SLACK_MODE=socket
SLACK_HTTP_PORT=3000
# public | ephemeral — visibility of /ai-trends answers
SLASH_RESPONSE_VISIBILITY=public
# Comma-separated channel IDs allowed to use the bot; empty = all
ALLOWED_CHANNEL_IDS=

# --- Tools (optional) ---
# Raises GitHub API rate limit from 60 to 5000 req/h
GITHUB_TOKEN=
# low | medium | high — how much page text hosted web search feeds the model
WEB_SEARCH_CONTEXT_SIZE=medium
HTTP_TIMEOUT_SECONDS=15
TOOL_CACHE_TTL_SECONDS=900

# --- Agent runtime ---
AGENT_MAX_TURNS=12
AGENT_TIMEOUT_SECONDS=240
SESSION_DB_PATH=data/sessions.sqlite3

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false
